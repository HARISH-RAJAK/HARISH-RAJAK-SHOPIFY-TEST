{% style %}
  /* Fonts import (if not already in theme) */
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Jost:wght@400;500&family=Lustria&display=swap');

  .custom-banner-section * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
  }

  .banner-wrapper {
      width: 100%;
      max-width: 1440px;
      margin: 0 auto;
      background-color: #FFFFFF;
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
  }

  /* --- ROW 1: Top Bar --- */
  .row-top {
      width: 100%;
      /* Height scales with width, capped at 64px */
      height: min(64px, 4.44vw);
      min-height: 40px; /* Minimum accessible height */
      display: flex;
      align-items: center;
      justify-content: space-between;
      /* Padding scales, capped at settings */
      padding: min({{ section.settings.top_bar_padding_y }}px, 0.7vw) min({{ section.settings.top_bar_padding_x }}px, 3.47vw);
      background-color: {{ section.settings.top_bar_bg }};
  }

  .brand-text {
      font-family: 'Lustria', serif;
      font-weight: 400;
      /* Font size scales, capped at settings */
      font-size: min({{ section.settings.brand_size }}px, calc({{ section.settings.brand_size }} / 1440 * 100vw));
      line-height: 100%;
      color: {{ section.settings.brand_color }};
      white-space: nowrap;
      text-transform: uppercase;
  }

  .text-item {
      font-family: 'Jost', sans-serif;
      font-weight: 400;
      font-size: min({{ section.settings.center_text_size }}px, calc({{ section.settings.center_text_size }} / 1440 * 100vw));
      text-align: center;
      color: {{ section.settings.center_text_color }};
      display: flex;
      align-items: center;
      justify-content: center;
  }

  .btn-item {
      /* Width/Height scale, capped at desktop */
      width: min(207px, 14.37vw);
      height: min(44px, 3.05vw);
      background-color: {{ section.settings.top_btn_bg }};
      position: relative;
      display: block;
      text-decoration: none;
      flex-shrink: 0;
  }

  .btn-item .line {
      position: absolute;
      left: 0;
      top: 0;
      width: 1px;
      height: 100%;
      background-color: {{ section.settings.top_btn_text_color }};
  }

  .btn-item .label {
      position: absolute;
      width: 100%;
      height: 100%;
      left: 0;
      top: 0;
      /* Padding to center text but avoid arrow overlap */
      padding-left: 10%;
      padding-right: 20%;
      font-family: 'Jost', sans-serif;
      font-weight: 400;
      font-size: min(16px, 1.11vw); /* Scales with container */
      display: flex;
      align-items: center;
      justify-content: center;
      text-transform: uppercase;
      white-space: nowrap; /* Prevent wrapping */
      overflow: hidden; /* Safety */
      color: {{ section.settings.top_btn_text_color }};
  }

  .btn-item .arrow {
      position: absolute;
      width: 10%; /* Reduced width to prevent overlap */
      height: 0px;
      right: 8%; /* Positioned safely */
      top: 50%;
      border-top: 1.5px solid {{ section.settings.top_btn_text_color }};
  }

  .btn-item .arrow::after {
      content: '';
      position: absolute;
      right: 0;
      top: -4px;
      width: 6px; /* Keep arrowhead fixed or scale? Fixed is cleaner for small details */
      height: 6px;
      border-top: 1.5px solid {{ section.settings.top_btn_text_color }};
      border-right: 1.5px solid {{ section.settings.top_btn_text_color }};
      transform: rotate(45deg);
  }

  /* --- ROW 2: Image Composition --- */
  .row-middle {
      width: 100%;
      aspect-ratio: 1440 / 780;
      position: relative;
      background-color: #FFFFFF;
  }

  .banner-img {
      width: 100%;
      height: 50%; /* 390px / 780px = 0.5 */
      display: block;
      object-fit: cover;
  }

  .frame-2 {
      position: absolute;
      width: 61.8%; /* 890px */
      height: auto;
      top: 48.46%; /* 378px */
      left: 38.19%; /* 550px */
      object-fit: contain;
      z-index: 5;
  }

  .gift-guide-text {
      position: absolute;
      left: 4.65%; /* 67px */
      top: 54.48%; /* 425px */
      width: 32%; /* 459px */
      font-family: 'Jost', sans-serif;
      font-weight: 500;
      /* Max 70px (or user setting), scales with vw */
      font-size: min({{ section.settings.main_title_size }}px, calc({{ section.settings.main_title_size }} / 1440 * 100vw));
      line-height: 100%;
      color: {{ section.settings.main_title_color }};
      z-index: 10;
  }

  .description-text {
      position: absolute;
      left: 4.65%;
      top: 69.87%; /* 545px */
      width: 33.54%; /* 483px */
      font-family: 'Jost', sans-serif;
      font-weight: 400;
      font-size: min({{ section.settings.description_size }}px, calc({{ section.settings.description_size }} / 1440 * 100vw));
      line-height: 140%;
      color: {{ section.settings.description_color }};
      z-index: 10;
  }

  .shop-btn {
      position: absolute;
      left: 4.65%;
      top: 87.05%; /* 679px */
      width: 15.27%; /* 220px */
      height: 6.41%; /* 50px of 780px (relative to parent height) */
      background-color: {{ section.settings.shop_btn_bg }};
      display: block;
      text-decoration: none;
      z-index: 10;
  }

  .shop-btn .line {
      position: absolute;
      left: 0;
      top: 0;
      width: 1px;
      height: 100%;
      background-color: {{ section.settings.shop_btn_color }};
  }

  .shop-btn .label {
      position: absolute;
      width: 100%;
      height: 100%;
      left: 0;
      top: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding-right: 15%; /* Space for arrow */
      font-family: 'Jost', sans-serif;
      font-weight: 400;
      font-size: min(16px, 1.11vw);
      text-transform: uppercase;
      color: {{ section.settings.shop_btn_color }};
  }

  .shop-btn .arrow {
      position: absolute;
      width: 11.6%; /* 25.5px / 220px */
      height: 0px;
      right: 10%;
      top: 50%;
      border-top: 1.5px solid {{ section.settings.shop_btn_color }};
  }

  .shop-btn .arrow::after {
      content: '';
      position: absolute;
      right: 0;
      top: -4px;
      width: 6px;
      height: 6px;
      border-top: 1.5px solid {{ section.settings.shop_btn_color }};
      border-right: 1.5px solid {{ section.settings.shop_btn_color }};
      transform: rotate(45deg);
  }

  /* --- ROW 3: Bottom Bar --- */
  .row-bottom {
      width: 100%;
      height: min(34px, 2.36vw);
      min-height: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: {{ section.settings.bottom_bar_bg }};
  }

  .sustain-text {
      width: 100%;
      text-align: center;
      font-family: 'Jost', sans-serif;
      font-weight: 400;
      font-size: min({{ section.settings.sustain_font_size }}px, calc({{ section.settings.sustain_font_size }} / 1440 * 100vw));
      color: {{ section.settings.sustain_text_color }};
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
  }

  /* Final safeguard for very small devices */
  @media (max-width: 480px) {
    .text-item { display: none; }
    .btn-item { width: 40%; }
    .btn-item .label { font-size: 10px; }
    .row-top { gap: 10px; }
  }
{% endstyle %}

<div class="custom-banner-section">
  <div class="banner-wrapper">
    <!-- ROW 1: Top Bar (64px) -->
    <div class="row-top">
      <!-- Brand -->
      <div class="brand-item">
        <div class="brand-text">{{ section.settings.brand_text }}</div>
      </div>

      <!-- Center Text -->
      <div class="text-item">{{ section.settings.center_text }}</div>

      <!-- Button -->
      <a href="#" class="btn-item">
        <span class="line"></span>
        <!-- Missing line restored -->
        <span class="label">{{ section.settings.top_btn_text }}</span>
        <span class="arrow"></span>
      </a>
    </div>

    <!-- ROW 2: Banner Image (780px) -->
    <div class="row-middle">
      {% if section.settings.banner_image != blank %}
        {{ section.settings.banner_image | image_url: width: 1440 | image_tag: class: 'banner-img', loading: 'lazy' }}
      {% endif %}

      {% if section.settings.overlay_image != blank %}
        {{ section.settings.overlay_image | image_url: width: 890 | image_tag: class: 'frame-2', loading: 'lazy' }}
      {% endif %}

      <div class="gift-guide-text">{{ section.settings.main_title }}</div>

      <div class="description-text">
        {{ section.settings.description }}
      </div>

      <a href="#" class="shop-btn">
        <span class="line"></span>
        <span class="label">{{ section.settings.shop_btn_text }}</span>
        <span class="arrow"></span>
      </a>
    </div>

    <!-- ROW 3: Sustainability Bar (34px) -->
    <div class="row-bottom">
      <div class="sustain-text">
        {{ section.settings.sustain_text }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "header",
