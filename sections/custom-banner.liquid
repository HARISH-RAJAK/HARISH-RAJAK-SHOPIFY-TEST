{% style %} /* Fonts import (if not already in theme) */ @import
url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Jost:wght@400;500&family=Lustria&display=swap');

.custom-banner-section * { box-sizing: border-box; margin: 0; padding: 0; }

.banner-wrapper { width: 100%; max-width: 1440px; margin: 0 auto; background-color: #FFFFFF; display: flex;
flex-direction: column; position: relative; overflow: hidden; }

/* --- ROW 1: Top Bar --- */ .row-top { width: 100%; height: 64px; display: flex; align-items: center; justify-content:
space-between; /* Replaces fixed large gap */ padding: {{ section.settings.top_bar_padding_y }}px
{{ section.settings.top_bar_padding_x }}px; /* 10px 50px default */ background-color: {{ section.settings.top_bar_bg }};
}

.brand-text { font-family: 'Lustria', serif; font-weight: 400; font-size: {{ section.settings.brand_size }}px;
line-height: 100%; color: {{ section.settings.brand_color }}; white-space: nowrap; text-transform: uppercase; }

.text-item { font-family: 'Jost', sans-serif; font-weight: 400; font-size: {{ section.settings.center_text_size }}px;
text-align: center; color: {{ section.settings.center_text_color }}; display: flex; align-items: center;
justify-content: center; /* Hide on small screens if needed, strictly scalable for now */ }

.btn-item { width: 207px; height: 44px; background-color: {{ section.settings.top_btn_bg }}; position: relative;
display: block; text-decoration: none; flex-shrink: 0; /* Prevent squishing */ }

/* ... button internals remain same ... */ .btn-item .line { position: absolute; left: 0; top: 0; width: 1px; height:
44px; background-color: {{ section.settings.top_btn_text_color }}; }

.btn-item .label { position: absolute; width: 100%; height: 100%; left: 0; top: 0; padding-left: 20px; /* Adjust for
line */ font-family: 'Jost', sans-serif; font-weight: 400; font-size: 16px; line-height: 44px; text-align: center;
text-transform: uppercase; color: {{ section.settings.top_btn_text_color }}; display: flex; align-items: center;
justify-content: center; }

.btn-item .arrow { position: absolute; width: 24px; height: 0px; right: 20px; /* Position from right instead of fixed
left */ top: 50%; border-top: 1.5px solid {{ section.settings.top_btn_text_color }}; }

.btn-item .arrow::after { content: ''; position: absolute; right: 0; top: -4px; width: 6px; height: 6px; border-top:
1.5px solid {{ section.settings.top_btn_text_color }}; border-right: 1.5px solid
{{ section.settings.top_btn_text_color }}; transform: rotate(45deg); }

/* --- ROW 2: Image Composition --- */ .row-middle { width: 100%; aspect-ratio: 1440 / 780; /* fluid height based on
width */ height: auto; position: relative; }

.banner-img { width: 100%; height: auto; aspect-ratio: 1440 / 390; display: block; object-fit: cover; }

/* Using percentages for absolute positioning to maintain structure on resize */ .frame-2 { position: absolute; width:
61.8%; /* 890 / 1440 */ height: auto; aspect-ratio: 890 / 402; top: 48.46%; /* 378 / 780 */ left: 38.19%; /* 550 / 1440
*/ object-fit: contain; z-index: 5; }

.gift-guide-text { position: absolute; left: 4.65%; /* 67 / 1440 */ top: 54.48%; /* 425 / 780 */ width: 32%; /* Approx
fit */ font-family: 'Jost', sans-serif; font-weight: 500; font-size: clamp(24px, 4.8vw,
{{ section.settings.main_title_size }}px); /* Responsive font size */ line-height: 100%; color:
{{ section.settings.main_title_color }}; z-index: 10; }

.description-text { position: absolute; left: 4.65%; top: 69.87%; /* 545 / 780 */ width: 33.5%; /* 483 / 1440 */
font-family: 'Jost', sans-serif; font-weight: 400; font-size: clamp(14px, 1.4vw,
{{ section.settings.description_size }}px); line-height: 140%; color: {{ section.settings.description_color }}; z-index:
10; }

.shop-btn { position: absolute; left: 4.65%; top: 87.05%; /* 679 / 780 */ width: 220px; /* Keep button fixed width
mostly, or scale? user said structure same. Buttons usually fixed. */ height: 50px; background-color:
{{ section.settings.shop_btn_bg }}; display: block; text-decoration: none; z-index: 10; } /* Mobile tweak for button if
screen is too small */ @media (max-width: 600px) { .shop-btn { width: 160px; height: 40px; } }

.shop-btn .line { position: absolute; left: 0; top: 0; width: 1px; height: 100%; background-color:
{{ section.settings.shop_btn_color }}; }

.shop-btn .label { position: absolute; width: 100%; height: 100%; left: 0; top: 0; display: flex; align-items: center;
justify-content: center; font-family: 'Jost', sans-serif; font-weight: 400; font-size: 16px; text-transform: uppercase;
color: {{ section.settings.shop_btn_color }}; padding-right: 30px; /* Space for arrow */ }

.shop-btn .arrow { position: absolute; width: 25.5px; height: 0px; right: 20px; top: 50%; border-top: 1.5px solid
{{ section.settings.shop_btn_color }}; }

.shop-btn .arrow::after { content: ''; position: absolute; right: 0; top: -4px; width: 6px; height: 6px; border-top:
1.5px solid {{ section.settings.shop_btn_color }}; border-right: 1.5px solid {{ section.settings.shop_btn_color }};
transform: rotate(45deg); }

/* --- ROW 3: Bottom Bar --- */ .row-bottom { width: 100%; height: 34px; display: flex; align-items: center;
justify-content: center; padding: 5px 20px; background-color: {{ section.settings.bottom_bar_bg }}; }

.sustain-text { width: 100%; text-align: center; font-family: 'Jost', sans-serif; font-weight: 400; font-size:
clamp(10px, 1.1vw, {{ section.settings.sustain_font_size }}px); color: {{ section.settings.sustain_text_color }};
white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } /* Responsive Utilities */ @media (max-width: 1024px)
{ .row-top { gap: 20px; } .text-item { display: none; } /* Hide center text on smaller screens if squished */ } @media
(max-width: 768px) { .banner-wrapper { height: auto; } .frame-2 { width: 80%; left: 10%; top: 40%; } }

<div class="custom-banner-section">
  <div class="banner-wrapper">
    <!-- ROW 1: Top Bar (64px) -->
    <div class="row-top">
      <!-- Brand -->
      <div class="brand-item">
        <div class="brand-text">{{ section.settings.brand_text }}</div>
      </div>

      <!-- Center Text -->
      <div class="text-item">{{ section.settings.center_text }}</div>

      <!-- Button -->
      <a href="#" class="btn-item">
        <span class="line"></span>
        <!-- Missing line restored -->
        <span class="label">{{ section.settings.top_btn_text }}</span>
        <span class="arrow"></span>
      </a>
    </div>

    <!-- ROW 2: Banner Image (780px) -->
    <div class="row-middle">
      {% if section.settings.banner_image != blank %}
        {{ section.settings.banner_image | image_url: width: 1440 | image_tag: class: 'banner-img', loading: 'lazy' }}
      {% endif %}

      {% if section.settings.overlay_image != blank %}
        {{ section.settings.overlay_image | image_url: width: 890 | image_tag: class: 'frame-2', loading: 'lazy' }}
      {% endif %}

      <div class="gift-guide-text">{{ section.settings.main_title }}</div>

      <div class="description-text">
        {{ section.settings.description }}
      </div>

      <a href="#" class="shop-btn">
        <span class="line"></span>
        <span class="label">{{ section.settings.shop_btn_text }}</span>
        <span class="arrow"></span>
      </a>
    </div>

    <!-- ROW 3: Sustainability Bar (34px) -->
    <div class="row-bottom">
      <div class="sustain-text">
        {{ section.settings.sustain_text }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "header",
      "content": "Row 1: Top Bar Settings"
    },
    {
      "type": "color",
      "id": "top_bar_bg",
      "label": "Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "range",
      "id": "top_bar_padding_y",
      "label": "Vertical Padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "top_bar_padding_x",
      "label": "Horizontal Padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Text",
      "default": "TISSO VISON"
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Brand Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "brand_size",
      "label": "Brand Font Size",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "text",
      "id": "center_text",
      "label": "Center Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "color",
      "id": "center_text_color",
      "label": "Center Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "center_text_size",
      "label": "Center Text Size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "text",
      "id": "top_btn_text",
      "label": "Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "color",
      "id": "top_btn_bg",
      "label": "Button Background",
      "default": "#FFF544"
    },
    {
      "type": "color",
      "id": "top_btn_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Row 2: Main Banner"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image (Frame 1)"
    },
    {
      "type": "image_picker",
      "id": "overlay_image",
      "label": "Overlay Graphic (Frame 2)"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title",
      "default": "The Gift Guide"
    },
    {
      "type": "color",
      "id": "main_title_color",
      "label": "Main Title Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "main_title_size",
      "label": "Main Title Size",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 70
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "text",
      "id": "shop_btn_text",
      "label": "Shop Button Text",
      "default": "Shop Now"
    },
    {
      "type": "color",
      "id": "shop_btn_bg",
      "label": "Shop Button Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "shop_btn_color",
      "label": "Shop Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Row 3: Sustainability Bar"
    },
    {
      "type": "color",
      "id": "bottom_bar_bg",
      "label": "Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "text",
      "id": "sustain_text",
      "label": "Sustainability Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "color",
