{% schema %}
{
  "name": "Custom Gift Banner",
  "tag": "section",
  "class": "custom-gift-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Top Bar"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Tisso Vison"
    },
    {
      "type": "text",
      "id": "top_text",
      "label": "Middle Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_btn_text",
      "label": "Button Text",
      "default": "Choose Gift"
    },
    {
      "type": "url",
      "id": "top_btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Hero Section"
    },
    {
      "type": "image_picker",
      "id": "hero_bg",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Main Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "hero_desc",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "hero_btn_text",
      "label": "Hero Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "hero_btn_link",
      "label": "Hero Button Link"
    },
    {
      "type": "header",
      "content": "Bottom Ticker"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker Text",
      "default": "Sustainable, Ethically Made Clothes in Sizes XXS to 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Gift Banner"
    }
  ]
}
{% endschema %}

<!-- Load Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@300;400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">

<div class="tisso-wrapper">

  <!-- Top Bar -->
  <header class="tisso-header">
    <div class="tisso-container header-inner">
      <div class="header-left">
        <a href="/" class="brand-logo">{{ section.settings.brand_name }}</a>
      </div>
      <div class="header-center">
        <p>{{ section.settings.top_text }}</p>
      </div>
      <div class="header-right">
        <a href="{{ section.settings.top_btn_link }}" class="top-btn">
          {{ section.settings.top_btn_text }}
          <span class="material-symbols-outlined icon-small">arrow_forward</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="tisso-hero" style="background-image: url('{% if section.settings.hero_bg != blank %}{{ section.settings.hero_bg | image_url: width: 2000 }}{% else %}https://lh3.googleusercontent.com/aida-public/AB6AXuCf5fD98kzKoBAYvkqpdkTFgzgG_iZchRDOUk4d_mlZUep-Uruo6i5V5oGBtFlRKkxAAL5TRxdWK6g46LrdYIeYvCpRbvANv15vHDrebH6YNQynvNslxt4x2prT-2cgHlmN0e1G1AIWnstAq-iYDrImsxq19wd841gf5QHLa5oNdyouYqVLcfID6I6dRrmJNCVNFxTWd4WcxBRf_OfuCxzJ-lBjXl-_sasFnG_BUd8H68a8Rh8Qm0YNVNF3nZ80ckpGpNqcb-GrCIM{% endif %}');">
    <div class="tisso-container hero-container">
      <div class="hero-content">
        <h1>{{ section.settings.hero_title }}</h1>
        <p>{{ section.settings.hero_desc }}</p>
        <a href="{{ section.settings.hero_btn_link }}" class="hero-btn">
          {{ section.settings.hero_btn_text }}
          <span class="material-symbols-outlined icon-large">arrow_right_alt</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Bottom Ticker -->
  <div class="tisso-ticker">
    <p>{{ section.settings.ticker_text }}</p>
  </div>

</div>

<style>
  /* Reset & Fonts */
  .tisso-wrapper {
    font-family: 'Inter', sans-serif;
    color: #000;
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    line-height: 1.5;
  }
  .tisso-wrapper * { box-sizing: border-box; }

  /* Utility */
  .tisso-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 24px;
    width: 100%;
  }

  /* Header Styles */
  .tisso-header {
    background-color: #f4f4f4; /* brandGray */
    border-bottom: 1px solid #e5e7eb;
    width: 100%;
  }
  .header-inner {
    height: 64px; /* h-16 */
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .header-left, .header-center, .header-right { flex: 1; }
  .header-center { text-align: center; }
  .header-right { display: flex; justify-content: flex-end; }

  .brand-logo {
    font-size: 20px; /* text-xl */
    font-weight: 700;
    letter-spacing: 0.1em; /* tracking-widest */
    text-transform: uppercase;
    text-decoration: none;
    color: #000;
  }

  .header-center p {
    font-size: 14px;
    font-weight: 500;
    margin: 0;
    display: none; /* hidden on small screens by default logic in tailwind */
  }
  @media (min-width: 768px) {
    .header-center p { display: block; }
  }

  .top-btn {
    background-color: #fff159; /* brandYellow */
    padding: 8px 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #000;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .top-btn:hover { opacity: 0.9; }

  /* Hero Styles */
  .tisso-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .hero-container { position: relative; z-index: 10; }

  .hero-content {
    max-width: 576px; /* max-w-xl */
    padding: 32px;
    background-color: rgba(255,255,255, 0.4);
    backdrop-filter: blur(4px);
  }
  @media (min-width: 768px) {
    .hero-content {
      background-color: transparent;
      backdrop-filter: none;
      padding: 0;
    }
  }

  .hero-content h1 {
    font-family: 'Playfair Display', serif;
    font-size: 60px; /* text-6xl */
    margin: 0 0 24px 0;
    line-height: 1;
    font-weight: 700;
  }
  @media (min-width: 768px) {
    .hero-content h1 { font-size: 96px; /* text-8xl */ }
  }

  .hero-content p {
    font-size: 18px;
    margin: 0 0 40px 0;
    max-width: 448px;
    line-height: 1.625;
  }

  .hero-btn {
    background-color: #000; /* brandBlack */
    color: #fff;
    padding: 16px 40px;
    display: inline-flex;
    align-items: center;
    gap: 16px;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .hero-btn:hover { background-color: #262626; }

  /* Ticker Styles */
  .tisso-ticker {
    background-color: #f4f4f4; /* brandGray */
    border-top: 1px solid #e5e7eb;
    padding: 12px 0;
    width: 100%;
  }
  .tisso-ticker p {
    font-size: 10px;
    text-align: center;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0;
  }
  @media (min-width: 768px) {
    .tisso-ticker p { font-size: 12px; }
  }

  /* Icons */
  .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
  .icon-small { font-size: 14px; }
  .icon-large { font-size: 20px; }
</style>
