{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Lustria&display=swap');

  /* RESET & BASIC */
  .custom-grid-section * { box-sizing: border-box; margin: 0; padding: 0; }

  /* Section Container */
  .product-section {
    width: 100%;
    max-width: 1440px;
    margin: 90px auto 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 20px;
  }

  .section-title {
    width: 100%;
    max-width: 1339px;
    margin-bottom: 30px;
    font-family: 'Lustria', serif;
    font-weight: 400;
    font-size: 36px;
    line-height: 120%;
    color: {{ section.settings.title_color | default: '#000000' }};
    text-align: left;
  }

  .product-grid {
    width: 100%;
    max-width: 1339px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .image-container {
    position: relative;
    width: 100%;
  }

  .product-card img.main-img {
    display: block;
    width: 100%;
    height: 444px;
    object-fit: cover;
  }

  /* PLUS ICON */
  .plus-icon {
    width: 22px;
    height: 22px;
    background: #F8F8F8;
    background: #F8F8F8E5;
    border: 1.5px solid #FFFFFF;
    box-shadow: 0px 3px 4px 0px #00000033;
    border-radius: 50%;
    position: absolute;
    top: 238px;
    left: 256.5px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
  }

  .vector-h { position: absolute; width: 8.46px; height: 0px; border-top: 1.5px solid #000000; }
  .vector-v { position: absolute; width: 0px; height: 8.46px; border-left: 1.5px solid #000000; }

  /* POPUP STYLES */
  .product-popup {
    position: absolute;
    width: 311px;
    height: 447px;
    background: #FFFFFF;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    z-index: 100;
    display: none;
    text-align: left;
  }

  .product-popup.active {
    display: block;
  }

  .popup-close {
    width: 12px;
    height: 12px;
    position: absolute;
    top: 12.7px;
    left: 278.8px;
    background: transparent;
    cursor: pointer;
  }
  .popup-close::before, .popup-close::after {
    content: ''; position: absolute; width: 100%; height: 1.5px; background: #000000; top: 50%; left: 0;
  }
  .popup-close::before { transform: rotate(45deg); }
  .popup-close::after { transform: rotate(-45deg); }

  .popup-image {
    position: absolute;
    width: 120px;
    height: 140px;
    top: 36px;
    left: 17px;
    object-fit: cover;
  }

  .popup-title {
    position: absolute;
    top: 49px;
    left: 145px;
    width: 136px;
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    font-size: 16px;
    line-height: 120%;
    color: #000000;
  }

  .popup-price {
    position: absolute;
    top: 88px;
    left: 145px;
    font-family: 'Lustria', serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 120%;
    color: #000000;
  }

  .popup-desc {
    position: absolute;
    top: 119px;
    left: 145px;
    width: 146px;
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    font-size: 14px;
    line-height: 110%;
    letter-spacing: -0.01em;
    color: #000000;
    overflow: hidden;
  }

  /* Color Selector */
  .color-selector {
    position: absolute;
    top: 186px;
    left: 20px;
    width: 271px;
    height: auto;
  }
  .color-label {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 130%;
    color: #333333;
    margin-bottom: 5px;
  }
  .color-options {
    position: relative;
    width: 271px;
    height: 40.44px;
    border: 0.5px solid #000000;
    display: flex;
  }
  .color-option {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 300ms ease-out;
  }

  /* Vertical Divider matching HTML structure */
  .option-divider {
    position: absolute;
    right: 0;
    top: 10%;
    height: 80%;
    width: 0.5px;
    background-color: #000000;
  }
  /* Remove divider for last child */
  .color-option:last-child .option-divider {
    display: none;
  }

  .color-option .option-text {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 100%;
    letter-spacing: -0.02em;
    text-transform: capitalize;
    color: #000000;
    position: relative;
    z-index: 2;
    transition: color 300ms ease-out;
  }
  /* Color Strips */
  .color-strip {
    position: absolute; left: 0; top: 0; height: 100%; width: 6px;
    border-right: 0.5px solid #000000; z-index: 2;
  }

  /* Helper classes from grid.css */
  .blue-strip { background-color: #0D499F; }
  .black-strip { background-color: #000000; }
  .red-strip { background-color: #FF0000; }
  .grey-strip { background-color: #808080; }
  .white-strip { background-color: #FFFFFF; border: 0.5px solid #000000; border-right: 0.5px solid #000000; }

  /* Selected Color State */
  .color-option.selected { background-color: #000000; }
  .color-option.selected .option-text { color: #FFFFFF; }

  /* Size Selector */
  .size-selector {
    position: absolute; top: 262px; left: 20px; width: 271px; height: auto;
  }
  .size-label {
    font-family: 'Jost', sans-serif; font-weight: 400; font-size: 14px; line-height: 130%; color: #333333;
  }
  .size-box {
    position: relative; width: 271px; height: 40.44px; margin-top: 5px;
    border: 0.5px solid #000000; display: flex; align-items: center; cursor: pointer;
  }
  .size-text {
    position: absolute; left: 13px; font-family: 'Jost', sans-serif; font-weight: 400; font-size: 16px;
    line-height: 100%; letter-spacing: -0.02em; color: #000000;
  }
  .size-box.selected .size-text {
    left: 0; width: 216px; text-align: center;
  }
  .size-divider {
    position: absolute; left: 216px; width: 0.5px; height: 40px; background-color: #000000;
  }
  .size-arrow {
    position: absolute; left: 238px; width: 10px; height: 10px;
    border-right: 1.5px solid #000000; border-bottom: 1.5px solid #000000; transform: rotate(45deg);
  }
  .size-box.open .size-arrow {
    transform: rotate(225deg); top: 18px;
  }

  /* Size Dropdown */
  .size-dropdown {
    position: absolute; top: 45px; left: 0; width: 271px; height: 99px;
    background: #FFFFFF; border: 1px solid #000000; z-index: 101;
    display: none; overflow-y: auto;
    scrollbar-width: none; -ms-overflow-style: none;
  }
  .size-dropdown::-webkit-scrollbar { display: none; }
  .size-dropdown.open { display: block; }
  .size-option {
    padding: 10px; font-family: 'Jost', sans-serif; font-size: 16px;
    cursor: pointer; border-bottom: 0.5px solid #E0E0E0; text-align: center;
  }
  .size-option:hover { background-color: #F8F8F8; }

  /* Add to Cart */
  .add-to-cart-btn {
    position: absolute; top: 377px; left: 20px; width: 271px; height: 45px;
    background: #000000; display: flex; align-items: center; justify-content: center; cursor: pointer;
    border: none;
  }
  .atc-text {
    font-family: 'Jost', sans-serif; font-weight: 400; font-size: 16px;
    line-height: 20.48px; text-align: center; text-transform: uppercase; color: #FFFFFF;
  }
  .atc-arrow {
    position: absolute; left: 226.41px; width: 33.7px; height: 0px; border-top: 1.5px solid #FFFFFF;
  }
  .atc-arrow::after {
    content: ''; position: absolute; right: 0; top: -4px; width: 6px; height: 6px;
    border-top: 1.5px solid #FFFFFF; border-right: 1.5px solid #FFFFFF; transform: rotate(45deg);
  }

  /* Responsive - Mobile/Tablet */
  @media (max-width: 1024px) {
    .product-grid { grid-template-columns: repeat(2, 1fr); }
    .product-card img.main-img { height: auto; aspect-ratio: 433 / 444; }
    .plus-icon { top: 53.6%; left: 60%; }
  }

  @media (max-width: 600px) {
    .product-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .section-title { font-size: 24px; text-align: center; }
    .product-card img.main-img { height: 186.42px; width: 100%; object-fit: cover; }

    .plus-icon {
         width: 15px; height: 15px;
         top: 100px; left: 70%;
    }
    .vector-h { width: 6px; } .vector-v { height: 6px; }
  }
{% endstyle %}

<div class="custom-grid-section">
  <div class="product-section">
    <div class="section-title">{{ section.settings.product_section_title }}</div>

    <div class="product-grid">
      {% assign selected_collection = collections[section.settings.collection_id] %}
      {% if selected_collection != blank and selected_collection.products_count > 0 %}
        {% for product in selected_collection.products limit: section.settings.products_to_show %}
          <div class="product-card">
            <div class="image-container">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 600 | image_tag: class: 'main-img', loading: 'lazy' }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'main-img' }}
              {% endif %}

              <!-- Plus Icon -->
              <div class="plus-icon">
                <div class="vector-h"></div>
                <div class="vector-v"></div>
              </div>
            </div>

            <!-- Popup -->
            <div class="product-popup">
              <div class="popup-close"></div>

              <!-- Popup Main Image -->
              <img
                class="popup-image"
                src="{{ product.featured_image | image_url: width: 240 }}"
                alt="{{ product.title }}"
                width="120"
                height="140"
                loading="lazy"
              >

              <div class="popup-title">{{ product.title }}</div>
              <div class="popup-price">{{ product.price | money }}</div>
              <div class="popup-desc">{{ product.description | strip_html | truncatewords: 15 }}</div>

              <!-- Hidden Data -->
              <div class="product-options-data" style="display:none;">
                <script type="application/json">
                  {{ product.variants | json }}
                </script>
              </div>

              {% for option in product.options_with_values %}
                {% assign option_name_downcase = option.name | downcase %}
                {% assign option_position = option.position %}

                <!-- Color Selector -->
                {% if option_name_downcase == 'color' or option_name_downcase == 'colour' %}
                  <div class="color-selector" data-position="option{{ option_position }}">
                    <div class="color-label">{{ option.name }}</div>
                    <div class="color-options">
                      {% for value in option.values %}
                        {% assign val_down = value | downcase %}
                        <div class="color-option {% if forloop.first %}selected{% endif %}" data-value="{{ value }}">
                          <!-- Color Strip with inline style fallback -->
                          <div
                            class="color-strip {{ val_down }}-strip"
                            style="background-color: {{ val_down }}; border-right: 0.5px solid #000000;"
                          ></div>
                          <span class="option-text">{{ value }}</span>
                          <div class="option-divider"></div>
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                {% endif %}

                <!-- Size Selector -->
                {% if option_name_downcase == 'size' %}
                  <div class="size-selector" data-position="option{{ option_position }}">
                    <div class="size-label">{{ option.name }}</div>
                    <div class="size-box {% if forloop.first %}selected{% endif %}">
                      <span class="size-text">
                        {%- if forloop.first %}{{ option.values.first }}{% else %}Choose your size{% endif -%}
                      </span>
                      <div class="size-divider"></div>
                      <div class="size-arrow"></div>
                    </div>
                    <div class="size-dropdown">
                      {% for value in option.values %}
                        <div class="size-option" data-value="{{ value }}">{{ value }}</div>
                      {% endfor %}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}

              <!-- Add to Cart Form -->
              <form method="post" action="{{ routes.cart_add_url }}" class="add-to-cart-form">
                <input type="hidden" name="id" class="variant-id-input" value="{{ product.variants.first.id }}">
                <button type="submit" class="add-to-cart-btn" style="border:none;">
                  <span class="atc-text">Add to cart</span>
                  <div class="atc-arrow"></div>
                </button>
              </form>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% comment %} Fallback for empty state {% endcomment %}
        {% for i in (1..3) %}
          <div class="product-card">
            <div class="image-container">
              {{ 'product-' | append: i | placeholder_svg_tag: 'main-img' }}
              <div class="plus-icon">
                <div class="vector-h"></div>
                <div class="vector-v"></div>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Helper: Format Money
    const formatMoney = (cents) => {
      return (cents / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
    };

    // Helper: Find Matching Variant with loose type checking and comprehensive logging
    const findVariant = (variants, selections) => {
      return variants.find((variant) => {
        return Object.keys(selections).every((key) => {
          // Shopify variant keys are option1, option2, etc.
          // Selections keys are option1, option2 (from data-position)
          return variant[key] === selections[key];
        });
      });
    };

    // Initialize Cards
    document.querySelectorAll('.product-card').forEach((card) => {
      const variantsScript = card.querySelector('script[type="application/json"]');
      if (!variantsScript) return;

      const variants = JSON.parse(variantsScript.textContent);
      const selections = {};

      const updateCardState = () => {
        const matchedVariant = findVariant(variants, selections);
        const priceEl = card.querySelector('.popup-price');
        const imgEl = card.querySelector('.popup-image');
        const inputEl = card.querySelector('.variant-id-input');
        const atcBtn = card.querySelector('.add-to-cart-btn');
        const atcText = card.querySelector('.atc-text');

        if (matchedVariant) {
          if (priceEl) priceEl.innerText = formatMoney(matchedVariant.price);

          if (matchedVariant.featured_image && matchedVariant.featured_image.src && imgEl) {
            // Basic image swap - can be improved with image sizing logic
            const src = matchedVariant.featured_image.src;
            if (src) imgEl.src = src;
          }

          if (inputEl) inputEl.value = matchedVariant.id;

          if (atcBtn) {
            atcBtn.disabled = !matchedVariant.available;
            atcBtn.style.opacity = matchedVariant.available ? '1' : '0.5';
            atcBtn.style.pointerEvents = matchedVariant.available ? 'auto' : 'none';
            if (atcText) atcText.innerText = matchedVariant.available ? 'Add to cart' : 'Sold Out';
          }
        } else {
          // Variant doesn't exist (e.g. Red / XXL)
          if (atcBtn) {
            atcBtn.disabled = true;
            atcBtn.style.opacity = '0.5';
            atcBtn.style.pointerEvents = 'none';
            if (atcText) atcText.innerText = 'Unavailable';
          }
        }
      };

      // Initialize selections based on pre-selected DOM elements (loop first item)
      card.querySelectorAll('.color-selector, .size-selector').forEach((selector) => {
        const position = selector.getAttribute('data-position');
        // Find if any option is pre-selected (via liquid template logic)
        let selectedOpt =
          selector.querySelector('.color-option.selected') ||
          (selector.classList.contains('size-selector') ? selector.querySelector('.size-box.selected') : null);

        // For size selector, the box is selected, but we need the value.
        // If it's the first load, the size box might just have text in it.
        // Let's rely on finding the matching value.
        // Simpler: Just get the first option value if nothing else info is there?
        // Actually, for size selector, we updated the template to set size-box selected if first.
        // We need to know WHICH value is selected.
        // In the size-box text, we put the value.

        if (selector.classList.contains('size-selector')) {
          const val = selector.querySelector('.size-box .size-text').textContent.trim();
          if (val && val !== 'Choose your size') {
            selections[position] = val;
          } else {
            // Nothing selected yet? Or get first value?
            // Let's default to first value to match the variant initially
            const firstVal = selector.querySelector('.size-option')?.getAttribute('data-value');
            if (firstVal) selections[position] = firstVal;
          }
        } else {
          // Color
          if (selectedOpt) {
            selections[position] = selectedOpt.getAttribute('data-value');
          }
        }
      });

      // Perform initial update
      updateCardState();

      // Listener: Color
      card.querySelectorAll('.color-option').forEach((opt) => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const wrapper = opt.closest('.color-selector');
          const position = wrapper.getAttribute('data-position');
          const value = opt.getAttribute('data-value');

          wrapper.querySelectorAll('.color-option').forEach((o) => o.classList.remove('selected'));
          opt.classList.add('selected');

          selections[position] = value;
          updateCardState();
        });
      });

      // Listener: Size Option Click
      card.querySelectorAll('.size-option').forEach((opt) => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const wrapper = opt.closest('.size-selector');
          const position = wrapper.getAttribute('data-position');
          const value = opt.getAttribute('data-value');

          const box = wrapper.querySelector('.size-box');
          const text = box.querySelector('.size-text');
          const dropdown = wrapper.querySelector('.size-dropdown');

          text.textContent = value;
          box.classList.add('selected');
          dropdown.classList.remove('open');
          box.classList.remove('open');

          selections[position] = value;
          updateCardState();
        });
      });
    });

    // Global UI Interaction (Popup Toggles)
    document.querySelectorAll('.plus-icon').forEach((icon) => {
      icon.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = icon.closest('.product-card');
        const popup = card.querySelector('.product-popup');

        // Close others
        document.querySelectorAll('.product-popup.active').forEach((p) => {
          if (p !== popup) p.classList.remove('active');
        });

        if (popup) popup.classList.toggle('active');
      });
    });

    document.querySelectorAll('.popup-close').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const popup = btn.closest('.product-popup');
        if (popup) popup.classList.remove('active');
      });
    });

    // Size Dropdown Toggle
    document.querySelectorAll('.size-box').forEach((box) => {
      box.addEventListener('click', (e) => {
        e.stopPropagation();
        const parent = box.closest('.size-selector');
        const dropdown = parent.querySelector('.size-dropdown');
        const isOpen = dropdown.classList.contains('open');

        // Close all other dropdowns
        document.querySelectorAll('.size-dropdown').forEach((d) => d.classList.remove('open'));
        document.querySelectorAll('.size-box').forEach((b) => b.classList.remove('open'));

        if (!isOpen) {
          dropdown.classList.add('open');
          box.classList.add('open');
        }
      });
    });

    // Click Outside Listener
    document.addEventListener('click', (e) => {
      // Close Popup if clicked outside
      if (!e.target.closest('.product-popup') && !e.target.closest('.plus-icon')) {
        document.querySelectorAll('.product-popup.active').forEach((p) => p.classList.remove('active'));
      }
      // Close Size Dropdown if clicked outside
      if (!e.target.closest('.size-selector')) {
        document.querySelectorAll('.size-dropdown.open').forEach((d) => d.classList.remove('open'));
        document.querySelectorAll('.size-box.open').forEach((b) => b.classList.remove('open'));
      }
    });
  });
</script>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "product_section_title",
      "label": "Section Title",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "collection",
      "id": "collection_id",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}
